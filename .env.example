# Copy this file to ".env" for local development.
# Find all six values in Firebase Console -> Project Settings -> General ->
# "Your apps" -> the web app's SDK config snippet.

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------
# Google sign-in setup (one-time, in the Firebase console):
#   1. Firebase Console -> Authentication -> Sign-in method -> Google ->
#      enable it (this provisions a Google OAuth client for you).
#   2. Authentication -> Settings -> Authorized domains -> add your Firebase
#      Hosting domain (e.g. your-project.web.app) once you have it, plus
#      localhost for local dev (usually already there by default).
# ------------------------------------------------------------------------
